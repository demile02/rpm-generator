# Contoh konfigurasi RPM Generator (self-host).
# Salin menjadi `.env` lalu isi nilainya:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/macOS)
# File `.env` tidak boleh di-commit (sudah di .gitignore).

# Kunci API gateway 9Router. Wajib diisi bila gateway mengaktifkan
# "Require API key"; bila gateway tidak mewajibkan, boleh kosong.
NINE_ROUTER_API_KEY=

# Alamat gateway 9Router (default instalasi lokal).
NINE_ROUTER_BASE_URL=http://localhost:20128

# Kombinasi model. Jangan diubah (pipeline memakai combo `rpm`).
NINE_ROUTER_COMBO=rpm

# Batas waktu per percobaan AI (detik). Payload besar dapat memerlukan
# waktu lebih lama; jangan dikecilkan tanpa alasan.
NINE_ROUTER_TIMEOUT=120

# Percobaan ulang dan jeda antar-percobaan.
NINE_ROUTER_MAX_RETRIES=2
NINE_ROUTER_BACKOFF_BASE=1.0

# Lokasi database SQLite (default: db/rpm_generator.db).
# RPM_GENERATOR_DB=db/rpm_generator.db
